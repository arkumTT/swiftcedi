{
  "name": "swiftcedi-backend",
  "version": "0.1.0",
  "description": "SwiftCedi microfinance banking platform — backend API",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "predev": "npm run migrate && npm run seed:admin",
    "start": "node src/server.js",
    "prestart": "npm run migrate && npm run seed:admin",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed:admin": "node src/db/seedAdmin.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
